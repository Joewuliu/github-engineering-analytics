APP_NAME="GitHub Engineering Analytics"
APP_ENV=development
LOG_LEVEL=INFO

# These "localhost" defaults are for running the app's Python processes
# directly on your machine against Dockerized Postgres/Redis (see README
# "Local development"). If you instead run the whole stack via
# `docker compose up --build`, compose.yaml automatically overrides both of
# these to the in-network service hostnames (db:5432, redis:6379) for the
# api/worker/migrate containers -- you do not need to (and should not) edit
# these values for that workflow.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/github_analytics
DB_ECHO=false

# Dramatiq queue transport for background repository sync (Milestone 8).
REDIS_URL=redis://localhost:6379/0

# Deployment-capability flag, NOT an environment flag (APP_ENV=production
# does not imply this is false) -- whether THIS deployment has a worker
# able to process background sync jobs at all. Leave true for local
# development and Docker Compose (both run a real worker). Only a
# deployment with no Background Worker provisioned (e.g. a free-tier Render
# demo) should set this false; POST /me/repositories/{id}/sync then returns
# 503 instead of creating a job nothing will ever process. See README
# "Free hosted demo".
BACKGROUND_SYNC_ENABLED=true

# GitHub REST API access. GITHUB_TOKEN is optional -- public repositories work
# without one; GitHub just applies a lower unauthenticated rate limit
# (60 requests/hour vs. 5000/hour with a token). Never commit a real token.
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_REQUEST_TIMEOUT=10

# GitHub OAuth (Sign in with GitHub). Create an OAuth App at
# https://github.com/settings/developers -- callback URL must match
# GITHUB_OAUTH_CALLBACK_URL exactly. Never commit real values. Both may be
# left blank (sign-in simply won't work until set) -- everything else,
# including `docker compose up --build`, boots fine without them. CI's
# Docker smoke test fills these with obviously-fake placeholders
# (GITHUB_OAUTH_CLIENT_ID=ci-placeholder) purely to boot the stack; it never
# performs an OAuth login or calls GitHub.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/auth/github/callback

# Session lifetime (seconds). Sessions use random opaque tokens hashed with
# SHA-256 before storage -- no signing secret is needed.
SESSION_MAX_AGE_SECONDS=1209600
OAUTH_STATE_MAX_AGE_SECONDS=600
